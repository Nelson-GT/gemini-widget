<Window x:Class="GeminiWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GeminiWidget"
        Title="Gemini Usage"
        Width="240" Height="146"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" ShowActivated="False"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Opacity="0.28">

    <Window.Resources>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <!-- Barra de progreso delgada y redondeada. El color se toma de Foreground. -->
        <Style x:Key="UsageBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="2" Background="#2E3035" />
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    CornerRadius="2"
                                    Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#C9CDD2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PercentLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#E6E8EB" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ResetLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="#6E7480" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#DADDE1" />
            <Setter Property="Background" Value="#2E3035" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3D44" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Opacidad en reposo = 0.28; al pasar el cursor sube a 0.95 con animación suave. -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.95" Duration="0:0:0.18" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.28" Duration="0:0:0.35" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="Card"
            Margin="6"
            CornerRadius="12"
            Background="#EE1E1F22"
            BorderBrush="#2E3035"
            BorderThickness="1"
            MouseLeftButtonDown="OnMouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Actualizar ahora" Click="OnRefreshClick" />
                <MenuItem Header="Iniciar sesión en Gemini" Click="OnLoginClick" />
                <Separator />
                <MenuItem Header="Salir" Click="OnCloseClick" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid Margin="12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="Gemini" FontSize="12" FontWeight="SemiBold"
                           Foreground="#E6E8EB" VerticalAlignment="Center" />
                <Button x:Name="CloseButton" Content="✕" Width="18" Height="18" Padding="0"
                        Style="{StaticResource FlatButton}" Background="Transparent"
                        Foreground="#8A8F98" FontSize="10"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        ToolTip="Salir" Click="OnCloseClick" />
            </Grid>

            <!-- Uso actual -->
            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <Grid>
                    <TextBlock Text="Uso actual" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="{Binding CurrentUsageText}" Style="{StaticResource PercentLabel}" />
                </Grid>
                <ProgressBar Style="{StaticResource UsageBar}" Foreground="#4C8DFF"
                             Value="{Binding CurrentUsagePercentage, Mode=OneWay}" Margin="0,5,0,3" />
                <TextBlock Text="{Binding CurrentResetTime}" Style="{StaticResource ResetLabel}" />
            </StackPanel>

            <!-- Límite semanal -->
            <StackPanel Grid.Row="2">
                <Grid>
                    <TextBlock Text="Límite semanal" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="{Binding WeeklyUsageText}" Style="{StaticResource PercentLabel}" />
                </Grid>
                <ProgressBar Style="{StaticResource UsageBar}" Foreground="#B072F5"
                             Value="{Binding WeeklyUsagePercentage, Mode=OneWay}" Margin="0,5,0,3" />
                <TextBlock Text="{Binding WeeklyResetTime}" Style="{StaticResource ResetLabel}" />
            </StackPanel>

            <!-- Pie: estado y botón de inicio de sesión -->
            <Grid Grid.Row="3" Margin="0,8,0,0" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding StatusMessage}" FontSize="9" Foreground="#6E7480"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                <Button Content="Iniciar sesión" Style="{StaticResource FlatButton}"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVisibility}}"
                        Padding="8,3" FontSize="10"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="OnLoginClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
